# --- Core security (required in production) --------------------------------
# Both must be set and at least 32 characters once NODE_ENV=production, or the
# backend refuses to start. They are also required in development as soon as
# DATABASE_URL is set, because persisted connection passwords are encrypted
# with HELIX_CRYPTO_KEY and must stay decryptable across restarts.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HELIX_JWT_SECRET=
HELIX_CRYPTO_KEY=

NODE_ENV=development

# --- Persistence -------------------------------------------------------------
# Leave unset for zero-config in-memory demo mode (data resets on restart).
# Set to a Postgres connection string to persist users, connections, grants,
# and activity. Matches docker-compose.yml's `app-db` service by default:
# DATABASE_URL=postgresql://helix:helix@127.0.0.1:5433/helix
DATABASE_URL=

# --- Network -------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser.
# Defaults to the Vite dev server if unset. Required to be set explicitly to
# your real frontend origin(s) in production.
HELIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse-proxy hops in front of this server (e.g. "1" for a single
# nginx/ALB/Cloudflare in front of it). Leave unset if the backend is exposed
# directly. This feeds Express's trust-proxy setting, which the login rate
# limiter relies on to see the real client IP.
HELIX_TRUST_PROXY=

# --- Seed accounts -------------------------------------------------------
# Override the demo admin/operator passwords. Only used the first time the
# in-memory or empty-database seed runs. Change or disable these accounts
# after first boot in any shared environment.
HELIX_SEED_ADMIN_PASSWORD=
HELIX_SEED_OPERATOR_PASSWORD=

# --- Session recording -------------------------------------------------------
# Directory .guac recording files are written to for hosts with recording
# enabled (toggled per-host in the admin UI). Defaults to ./recordings under
# the backend's working directory. Point this at a volume with its own
# retention/backup policy in production — recordings can contain anything
# that was visible or typed in the session.
HELIX_RECORDINGS_DIR=

# --- Health checks -----------------------------------------------------------
# How often (ms) the automatic background sweep re-probes every host's real
# TCP reachability. Only runs when a real guacd relay is reachable, so it is
# a no-op in demo mode. Defaults to 20000 (20s). The admin "Check now" button
# always performs a real probe immediately, regardless of this interval.
HELIX_HEALTH_CHECK_MS=

# --- Email notifications (SMTP) ---------------------------------------------
# Optional. Leave HELIX_SMTP_HOST unset to disable email notifications
# entirely (access requests, grant decisions, MFA resets). No startup
# failure either way.
HELIX_SMTP_HOST=
HELIX_SMTP_PORT=587
HELIX_SMTP_USER=
HELIX_SMTP_PASS=
HELIX_SMTP_FROM=Helix Remote <noreply@helix.local>

# --- Slack notifications (incoming webhook) ---------------------------------
# Optional. Leave unset to disable Slack notifications (access requests,
# host up/down events). Create one at https://api.slack.com/messaging/webhooks
HELIX_SLACK_WEBHOOK_URL=

# --- Google OIDC -----------------------------------------------------------
USER_GOOGLE_CLIENT_ID=
USER_GOOGLE_CLIENT_SECRET=

# --- Microsoft Entra ID (Azure AD) + Graph ----------------------------------
USER_ENTRA_CLIENT_ID=
USER_ENTRA_CLIENT_SECRET=
USER_ENTRA_TENANT=common

# --- Optional: public origin for OAuth redirect (defaults to request host) --
USER_OIDC_REDIRECT_BASE=
USER_FRONTEND_ORIGIN=
